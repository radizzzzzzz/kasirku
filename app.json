{
  "expo": {
    "name": "KasirKu",
    "slug": "kasirku",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikasi KasirKu membutuhkan izin akses kamera untuk mengambil foto presensi karyawan."
      }
    },
    "android": {
      "package": "com.kasirku.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/qris.jpg",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan KasirKu menggunakan kamera untuk foto presensi karyawan."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/qris.jpg",
          "color": "#2563EB",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "kasirku-pos-app"
      }
    }
  }
}
